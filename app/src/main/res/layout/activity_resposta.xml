<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RespostaActivity">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="157dp"
        android:layout_marginBottom="12dp"
        android:text="ELEIÇÕES 2026"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="127dp"
        android:layout_marginBottom="132dp"
        android:text="PESQUISA DE INTENÇÃO"
        app:layout_constraintBottom_toTopOf="@+id/etIntencao"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etIntencao"
        android:layout_width="223dp"
        android:layout_height="49dp"
        android:layout_marginEnd="101dp"
        android:layout_marginBottom="187dp"
        android:ems="10"
        android:inputType="text"
        android:text="Candidato"
        app:layout_constraintBottom_toTopOf="@+id/btIntencao"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btIntencao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="150dp"
        android:layout_marginBottom="253dp"
        android:text="Confirmar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btVoltarInt"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:layout_marginEnd="156dp"
        android:layout_marginBottom="52dp"
        android:text="Voltar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>